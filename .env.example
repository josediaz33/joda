# JODA Parfums — variables de entorno
# Copiar a .env y completar los valores. No versionar .env.

# --- Base de datos ---
# Valores por defecto para infra/docker/docker-compose.yml (WP-B07), las
# mismas credenciales que usa el job `db` de CI (.github/workflows/ci.yml).
# ?schema=app es obligatorio (packages/db/README.md, hallazgo 5).
# Puerto de host 55432, no 5432: ver packages/db/README.md, hallazgo 7.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/joda?schema=app
DATABASE_URL_READONLY=
REDIS_URL=redis://localhost:6379

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (almacenamiento de imágenes) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=

# --- Aplicación ---
SESSION_SECRET=
APP_URL=
ADMIN_URL=
