# JODA Parfums — variables de entorno
# Copiar a .env y completar los valores. No versionar .env.

# --- Base de datos ---
# Tres credenciales, tres usos — no son intercambiables (docs/security-spec.md
# §3.1). Con la credencial equivocada en el proceso equivocado, RLS deja de
# evaluarse en silencio.
#
# DATABASE_URL: superusuario (`postgres`). SOLO migraciones y ETL desde
# scripts de packages/db (db:migrate, db:seed, db:reset, db:pull) — el
# equivalente local de `service_role`, nunca en runtime de apps/api.
# ?schema=app es obligatorio (packages/db/README.md, hallazgo 5).
# Puerto de host 55432, no 5432: ver packages/db/README.md, hallazgo 7.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/joda?schema=app

# DATABASE_URL_API: rol `joda_api` (NOBYPASSRLS). La única credencial que usa
# apps/api en runtime (WP-C02, withTenantTx) — sin esta variable el proceso
# no arranca, y arrancarlo con DATABASE_URL en su lugar dejaría a la API
# corriendo como superusuario, con RLS decorativo. La password de desarrollo
# la fija packages/db/seed/0002_seed_joda_api_credential.sql; en producción
# sale del gestor de secretos, fuera del alcance de WP-C02, cubierto por WP-F00.
DATABASE_URL_API=postgresql://joda_api:joda_api@localhost:55432/joda?schema=app

DATABASE_URL_READONLY=
# apps/api la exige desde WP-C03: ahí vive el caché de la sesión de personal
# de 15 min (docs/security-spec.md §4.2). infra/docker/docker-compose.yml ya
# la publica en este mismo valor.
REDIS_URL=redis://localhost:6379

# --- Supabase ---
# SUPABASE_URL y SUPABASE_ANON_KEY son obligatorias desde WP-C03: el login de
# personal verifica la contraseña contra Supabase Auth (ADR-004), detrás del
# puerto StaffAuthProvider (packages/domain/src/ports/staffAuth.ts). Sin un
# proyecto de Supabase real todavía (nadie lo provisionó — pendiente sin dueño,
# ver docs/backlog.md WP-C03b), completar acá con cualquier valor no vacío
# alcanza para arrancar el proceso: el adaptador real (apps/api/src/adapters/
# staffAuth/supabasePasswordProvider.ts) solo se ejercita de verdad cuando
# WP-C03b tenga un proyecto contra el cual correr.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (almacenamiento de imágenes) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=

# --- Aplicación ---
# SESSION_SECRET firma la cookie __Host-joda_a (docs/security-spec.md §4.1,
# WP-C03) — obligatoria, mínimo 32 caracteres. Generar una de desarrollo con
# `openssl rand -hex 32`; en producción sale del gestor de secretos (WP-F00).
SESSION_SECRET=

# MFA_ENCRYPTION_KEY cifra el secreto TOTP del segundo factor de personal
# (docs/security-spec.md §4.3/§6, WP-C04) — obligatoria, 64 caracteres
# hexadecimales (32 bytes, AES-256-GCM). A diferencia de SESSION_SECRET, este
# valor tiene que poder DESCIFRARSE (adapters/mfaSecretCipher.ts), no solo
# compararse: no es un hash. Generar una de desarrollo con
# `openssl rand -hex 32`; en producción sale del gestor de secretos (WP-F00).
MFA_ENCRYPTION_KEY=
# APP_URL es obligatoria desde WP-C09: es el origen público de ESTE proceso,
# el que emite la cookie de sesión de personal __Host-joda_a. apps/api valida
# al arrancar que MEDIA_PUBLIC_BASE_URL (abajo) resuelva a un HOST distinto de
# este — docs/security-spec.md §5, "servidos desde dominio distinto al del
# admin". No alcanza con un puerto distinto: las cookies no se aíslan por
# puerto (RFC 6265), solo por host.
APP_URL=http://localhost:3333
ADMIN_URL=

# --- Medios de catálogo (WP-C09, RF-CAT-08) ---
# MEDIA_STORAGE_DIR: raíz en disco del adaptador ObjectStorage de desarrollo
# (packages/domain/src/ports/storage.ts). apps/api rechaza arrancar con este
# adaptador si NODE_ENV=production (adapters/storage/localDiskStorage.ts) — el
# destino real es Supabase Storage, todavía sin adaptador (ver ADR pendiente).
MEDIA_STORAGE_DIR=./.data/media
# MEDIA_PUBLIC_BASE_URL: origen desde el que se sirven los derivados de
# catálogo — en desarrollo, el segundo servidor Fastify de
# apps/api/src/mediaServer.ts, en un host DISTINTO al de APP_URL
# (media.localhost, no localhost:otro-puerto).
MEDIA_PUBLIC_BASE_URL=http://media.localhost:3334
