# JODA Parfums — variables de entorno
# Copiar a .env y completar los valores. No versionar .env.

# --- Base de datos ---
# Tres credenciales, tres usos — no son intercambiables (docs/security-spec.md
# §3.1). Con la credencial equivocada en el proceso equivocado, RLS deja de
# evaluarse en silencio.
#
# DATABASE_URL: superusuario (`postgres`). SOLO migraciones y ETL desde
# scripts de packages/db (db:migrate, db:seed, db:reset, db:pull) — el
# equivalente local de `service_role`, nunca en runtime de apps/api.
# ?schema=app es obligatorio (packages/db/README.md, hallazgo 5).
# Puerto de host 55432, no 5432: ver packages/db/README.md, hallazgo 7.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/joda?schema=app

# DATABASE_URL_API: rol `joda_api` (NOBYPASSRLS). La única credencial que usa
# apps/api en runtime (WP-C02, withTenantTx) — sin esta variable el proceso
# no arranca, y arrancarlo con DATABASE_URL en su lugar dejaría a la API
# corriendo como superusuario, con RLS decorativo. La password de desarrollo
# la fija packages/db/seed/0002_seed_joda_api_credential.sql; en producción
# sale del gestor de secretos, fuera del alcance de WP-C02.
DATABASE_URL_API=postgresql://joda_api:joda_api@localhost:55432/joda?schema=app

DATABASE_URL_READONLY=
REDIS_URL=redis://localhost:6379

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (almacenamiento de imágenes) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=

# --- Aplicación ---
SESSION_SECRET=
APP_URL=
ADMIN_URL=
