{
  "name": "@joda/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tokens y primitivas compartidos entre admin y storefront.",
  "imports": {
    "#primitives/*": "./src/primitives/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    "./tokens.css": "./src/styles/tokens.css",
    "./primitives/*": "./src/primitives/*.tsx",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test src/styles/tokens.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/react": "19.3.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "react": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": "19.3.0"
  }
}
