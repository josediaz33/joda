  id           String?       @db.Uuid
  tenant_id    String?       @db.Uuid
  kind         product_kind?
  slug         String?       @db.Citext
  name         String?
  description  String?
  facets       Json?
  brand_name   String?
  brand_slug   String?       @db.Citext
  published_at DateTime?     @db.Timestamptz(6)

  @@schema("public")
}

view v_catalog_variants {
  id             String?       @db.Uuid
  tenant_id      String?       @db.Uuid
  product_id     String?       @db.Uuid
  sku            String?       @db.Citext
  variant_type   variant_type?
  uom            uom?
  size_ml        Decimal?      @db.Decimal(8, 2)
  price_pyg      BigInt?
  compare_at_pyg BigInt?
  in_stock       Boolean?

  @@schema("public")
}

