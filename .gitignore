node_modules/
dist/
.next/
.env
# Entorno local (WP-M18): `pnpm dev:setup` genera .env.local con secretos al azar
# por máquina. Nunca se versiona (.env.example es solo la referencia).
.env.local
.env*.local
.turbo/
coverage/
*.log
*.tsbuildinfo

# Dump de referencia local (no se versiona, ver packages/db/README.md)
packages/db/prisma/.reference-dump.sql

# Configuración local de Claude Code (no compartida)
.claude/settings.local.json

# Codex puede regenerar esto por su cuenta al correr en el repo. No se
# versiona: no es fuente de verdad, y .agents/ en particular no puede volver
# a traer copias de las skills de .claude/skills/ (ver AGENTS.md § Herramientas
# por agente) — una skill duplicada y desactualizada es peor que ninguna.
.agents/
.codex/

# Generado y borrado por packages/config/test/boundaries.test.ts en cada
# corrida; red de seguridad si un test cortado a la mitad lo deja tirado.
packages/domain/src/__boundary-check.generated.ts
packages/domain/src/__boundary-check.generated.test.ts

# Raíz de MEDIA_STORAGE_DIR (WP-C09, adaptador de disco local de
# ObjectStorage) — imágenes subidas en desarrollo, nunca contenido a
# versionar.
.data/

# Playwright (WP-M18, e2e/): resultados, trazas e informes de cada corrida.
e2e/test-results/
e2e/playwright-report/
