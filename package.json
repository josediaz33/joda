{
  "name": "joda-parfums-erp-ecomm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:setup": "node scripts/dev/setup.mjs",
    "dev:seed": "node scripts/dev/seed.mjs",
    "dev:totp": "node scripts/dev/totp.mjs",
    "e2e:smoke": "node scripts/dev/e2e-smoke.mjs",
    "build": "turbo run build",
    "test": "turbo run test && pnpm test:hooks && pnpm test:dev-scripts",
    "test:domain": "turbo run test --filter=@joda/domain",
    "test:hooks": "node --test scripts/hooks/lib/*.test.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @joda/db run db:migrate",
    "db:seed": "pnpm --filter @joda/db run db:seed",
    "db:pull": "pnpm --filter @joda/db run db:pull",
    "db:test": "pnpm --filter @joda/db run db:test",
    "db:reset": "pnpm --filter @joda/db run db:reset",
    "test:dev-scripts": "node --test scripts/dev/lib/*.test.mjs scripts/dev/*.test.mjs",
    "test:auth-local": "node scripts/dev/test-auth-local.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "pg": "8.16.3"
  }
}
